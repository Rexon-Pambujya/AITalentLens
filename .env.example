# Copy this file to .env in the repo root before running `docker compose up`.
# NEVER commit a real .env file - this template only contains safe local-dev
# defaults and placeholders (spec section 54).

# --- General ---
ENVIRONMENT=local
DEBUG=true

# --- Security ---
# Generate a real value for anything beyond local dev, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_LOCAL_DEV_ONLY

# --- Database (docker-compose overrides host to `postgres`; these values
# are for running the backend directly on your host instead of in Docker) ---
DATABASE_URL=postgresql+asyncpg://talentlens:talentlens@localhost:5432/talentlens
DATABASE_URL_SYNC=postgresql+psycopg2://talentlens:talentlens@localhost:5432/talentlens

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- AI / LLM provider ---
# "ollama" requires a local Ollama server (see OLLAMA_BASE_URL) - no API
# key or external network needed. Switch to "openai" and set
# OPENAI_API_KEY to use OpenAI instead. Use "groq" with GROQ_API_KEY for
# fast free inference - note Groq has no embeddings API, so semantic
# search/matching degrades gracefully (no embeddings) when using it alone.
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GROQ_API_KEY=
# Check https://console.groq.com/docs/models for current supported models -
# Groq periodically decommissions older ones (e.g. mixtral-8x7b-32768).
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector column dimension in the initial Alembic migration
# (currently 1536, tuned for OpenAI's text-embedding-3-small). Changing
# embedding models to one with a different dimensionality requires a new
# migration - see PROGRESS.md "Known issues".
EMBEDDING_DIMENSIONS=1536

# --- Object storage ---
# "local" writes to backend/storage on disk. "s3" (used by docker-compose,
# pointed at the bundled MinIO) needs the S3_* vars below.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=talentlens-resumes
AWS_ACCESS_KEY_ID=talentlens
AWS_SECRET_ACCESS_KEY=talentlens123
AWS_REGION=us-east-1

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=10

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
